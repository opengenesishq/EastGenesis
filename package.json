{
  "name": "caogen",
  "productName": "CaoGen",
  "version": "0.1.9",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Chaoyu Zhang",
    "email": "2900814034@qq.com",
    "url": "https://www.caogen.dev"
  },
  "description": "CaoGen — 多会话并行、多厂商可调度、3D 办公区的桌面 AI 工作台",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "generate:reference-helmet-source": "node scripts/generate-reference-helmet-source.mjs",
    "generate:reference-robot": "node scripts/generate-reference-robot-glb.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:fix-000-owner-kit": "node scripts/build-fix-000-owner-kit.mjs --required",
    "install:watercolor-runtime-assets": "python scripts/install-watercolor-runtime-assets.py",
    "dist": "npm run build && npm run prepare:native-build && electron-builder",
    "dist:mac": "npm run build && npm run prepare:native-build && electron-builder --mac",
    "dist:mac:x64": "npm run build && npm run prepare:native-build -- --arch x64 && electron-builder --mac --x64",
    "dist:mac:unsigned:x64": "npm run dist:mac:x64",
    "dist:mac:release:x64": "npm run release:mac:preflight:x64 && npm run build && npm run prepare:native-build -- --arch x64 && electron-builder --config electron-builder.release.cjs --mac --x64 --publish never && npm run test:macos-package-size:required -- --arch x64 && npm run test:macos-release-audit:required -- --arch x64 && npm run test:packaged-app:mac:x64",
    "dist:mac:release:arm64": "npm run release:mac:preflight:arm64 && npm run build && npm run prepare:native-build -- --arch arm64 && electron-builder --config electron-builder.release.cjs --mac --arm64 && npm run test:macos-package-size:required -- --arch arm64 && npm run test:macos-release-audit:required -- --arch arm64 && npm run test:packaged-app:mac:arm64",
    "dist:win:release:x64": "npm run test:windows-release-config && npm run build && npm run prepare:native-build && electron-builder --config electron-builder.release.cjs --win --x64 && npm run test:windows-release-audit:required -- --arch x64 && npm run test:packaged-app:win:x64",
    "dist:win:preview:x64": "node scripts/clean-windows-preview-artifacts.mjs && npm run test:windows-preview-config && npm run build && npm run prepare:native-build && electron-builder --config electron-builder.windows-preview.cjs --win --x64 && npm run test:windows-preview-audit:d0 && npm run test:packaged-app:win:preview:d0",
    "dist:dir": "npm run build && npm run prepare:native-build && electron-builder --dir",
    "prepare:native-build": "node scripts/prepare-native-build.cjs"
  },
  "build": {
    "appId": "com.caogen.app",
    "productName": "CaoGen",
    "electronLanguages": [
      "en",
      "zh_CN",
      "zh_TW"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/tree-sitter{,-*}/binding.gyp",
      "!node_modules/tree-sitter{,-*}/**/parser.c",
      "!node_modules/tree-sitter{,-*}/**/scanner.c",
      "!node_modules/tree-sitter{,-*}/**/scanner.cc",
      "!node_modules/node-pty/binding.gyp",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/scripts/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/third_party/**",
      "!node_modules/node-pty/typings/**",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/@fontsource/noto-sans-sc/**",
      "!node_modules/lucide-react/**",
      "!node_modules/**/*.map",
      "!node_modules/exceljs/dist/**",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/*-debug*",
      "!node_modules/pdfkit/.yarn/**",
      "!node_modules/pdfkit/js/pdfkit.es.js",
      "!node_modules/pdfkit/js/pdfkit.standalone.js",
      "!node_modules/puppeteer-core/src/**",
      "!node_modules/zod/src/**",
      "!node_modules/chromium-bidi/node_modules/zod/src/**",
      "!node_modules/docx/dist/index.iife.js",
      "!node_modules/docx/dist/index.mjs",
      "!node_modules/docx/dist/*.d.*",
      "!node_modules/pptxgenjs/dist/pptxgen.bundle.js",
      "!node_modules/pptxgenjs/dist/pptxgen.es.js",
      "!node_modules/pptxgenjs/dist/pptxgen.min.js",
      "!node_modules/pptxgenjs/types/**",
      "!node_modules/pptxgenjs/demos/**",
      "!node_modules/pptxgenjs/src/**",
      "!node_modules/pptxgenjs/libs/**",
      "!node_modules/pptxgenjs/tools/**",
      "!node_modules/pptxgenjs/.github/**",
      "!node_modules/pptxgenjs/.vscode/**",
      "!node_modules/pptxgenjs/node_modules/**",
      "!node_modules/pptxgenjs/.npmignore",
      "!node_modules/pptxgenjs/bower.json",
      "!node_modules/pptxgenjs/eslint.config.mjs",
      "!node_modules/pptxgenjs/gulpfile.js",
      "!node_modules/pptxgenjs/package-lock.json",
      "!node_modules/pptxgenjs/rollup.config.mjs",
      "!node_modules/pptxgenjs/tsconfig.json",
      "!node_modules/tree-sitter{,-*}/prebuilds/**",
      "!node_modules/typescript/lib/_tsc.js",
      "!node_modules/typescript/lib/{cs,de,es,fr,it,ja,ko,pl,pt-br,ru,tr}/**",
      "!node_modules/devtools-protocol/**",
      "!node_modules/puppeteer-core/lib/es5-iife/**",
      "!node_modules/puppeteer-core/**/*.d.ts",
      "!node_modules/chromium-bidi/**/*.d.ts",
      "!node_modules/zod/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.md",
      "!node_modules/@aws-sdk/**/*.d.ts",
      "!node_modules/@smithy/**/*.d.ts",
      "!node_modules/jimp/browser/**",
      "!node_modules/fontkit/dist/browser*",
      "!node_modules/@jimp/png/node_modules/pngjs/browser.js",
      "!node_modules/pngjs/browser.js"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon-win.png",
        "to": "icon-win.png"
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "COMMERCIAL-LICENSE.md",
        "to": "COMMERCIAL-LICENSE.md"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg/ffmpeg"
      },
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "ffmpeg/LICENSE"
      },
      {
        "from": "node_modules/@fontsource/noto-sans-sc/files/noto-sans-sc-chinese-simplified-400-normal.woff",
        "to": "office-font/NotoSansSC-Regular.woff"
      },
      {
        "from": "node_modules/@fontsource/noto-sans-sc/LICENSE",
        "to": "office-font/LICENSE"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/typescript-language-server/**",
      "**/node_modules/typescript/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "identity": null,
      "minimumSystemVersion": "14.0",
      "files": [
        "out/**/*",
        "package.json",
        "!node_modules/tree-sitter{,-*}/binding.gyp",
        "!node_modules/tree-sitter{,-*}/**/parser.c",
        "!node_modules/tree-sitter{,-*}/**/scanner.c",
        "!node_modules/tree-sitter{,-*}/**/scanner.cc",
        "!node_modules/node-pty/binding.gyp",
        "!node_modules/node-pty/deps/**",
        "!node_modules/node-pty/scripts/**",
        "!node_modules/node-pty/src/**",
        "!node_modules/node-pty/third_party/**",
        "!node_modules/node-pty/typings/**",
        "!node_modules/ffmpeg-static/**",
        "!node_modules/@fontsource/noto-sans-sc/**",
        "!node_modules/lucide-react/**",
        "!node_modules/**/*.map",
        "!node_modules/exceljs/dist/**",
        "!node_modules/sql.js/dist/sql-asm*",
        "!node_modules/sql.js/dist/worker*",
        "!node_modules/sql.js/dist/sql-wasm-browser*",
        "!node_modules/sql.js/dist/*-debug*",
        "!node_modules/pdfkit/.yarn/**",
        "!node_modules/pdfkit/js/pdfkit.es.js",
        "!node_modules/pdfkit/js/pdfkit.standalone.js",
        "!node_modules/puppeteer-core/src/**",
        "!node_modules/zod/src/**",
        "!node_modules/chromium-bidi/node_modules/zod/src/**",
        "!node_modules/docx/dist/index.iife.js",
        "!node_modules/docx/dist/index.mjs",
        "!node_modules/docx/dist/*.d.*",
        "!node_modules/pptxgenjs/dist/pptxgen.bundle.js",
        "!node_modules/pptxgenjs/dist/pptxgen.es.js",
        "!node_modules/pptxgenjs/dist/pptxgen.min.js",
        "!node_modules/pptxgenjs/types/**",
        "!node_modules/pptxgenjs/demos/**",
        "!node_modules/pptxgenjs/src/**",
        "!node_modules/pptxgenjs/libs/**",
        "!node_modules/pptxgenjs/tools/**",
        "!node_modules/pptxgenjs/.github/**",
        "!node_modules/pptxgenjs/.vscode/**",
        "!node_modules/pptxgenjs/node_modules/**",
        "!node_modules/pptxgenjs/.npmignore",
        "!node_modules/pptxgenjs/bower.json",
        "!node_modules/pptxgenjs/eslint.config.mjs",
        "!node_modules/pptxgenjs/gulpfile.js",
        "!node_modules/pptxgenjs/package-lock.json",
        "!node_modules/pptxgenjs/rollup.config.mjs",
        "!node_modules/pptxgenjs/tsconfig.json",
        "!node_modules/tree-sitter{,-*}/prebuilds/**",
        "!node_modules/typescript/lib/_tsc.js",
        "!node_modules/typescript/lib/{cs,de,es,fr,it,ja,ko,pl,pt-br,ru,tr}/**",
        "!node_modules/devtools-protocol/**",
        "!node_modules/puppeteer-core/lib/es5-iife/**",
        "!node_modules/puppeteer-core/**/*.d.ts",
        "!node_modules/chromium-bidi/**/*.d.ts",
        "!node_modules/zod/**/*.d.ts",
        "!node_modules/**/*.d.cts",
        "!node_modules/**/*.d.mts",
        "!node_modules/**/*.md",
        "!node_modules/@aws-sdk/**/*.d.ts",
        "!node_modules/@smithy/**/*.d.ts",
        "!node_modules/jimp/browser/**",
        "!node_modules/fontkit/dist/browser*",
        "!node_modules/@jimp/png/node_modules/pngjs/browser.js",
        "!node_modules/pngjs/browser.js",
        "!node_modules/**/prebuilds/!(darwin-${arch})/**",
        "!node_modules/@nut-tree-fork/libnut-linux/**",
        "!node_modules/@nut-tree-fork/libnut-win32/**"
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "CaoGen uses automation only for user-approved desktop actions."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "CaoGen ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ChaoYuZhang001",
        "repo": "CaoGen"
      }
    ],
    "win": {
      "icon": "resources/icon-win.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer.nsh",
      "removeDefaultUninstallWelcomePage": true,
      "uninstallDisplayName": "CaoGen ${version}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@iarna/toml": "^2.2.5",
    "chokidar": "^5.0.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "js-yaml": "^4.3.1",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "monaco-editor": "0.56.0",
    "node-cron": "^4.6.0",
    "node-gyp-build": "^4.8.4",
    "node-pty": "^1.1.0",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "https://codeload.github.com/otcaveuni-dev/PptxGenJS/tar.gz/2ea5bafc5a1260c108c7200f6a36519bb6d35bd7",
    "puppeteer-core": "^25.3.0",
    "sql.js": "^1.14.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-typescript": "^0.21.2",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "ws": "^8.21.0",
    "yauzl": "^2.10.0",
    "zip-stream": "^4.1.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "41.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "ffmpeg-static": "5.3.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.169.0",
    "tsx": "^4.20.6",
    "vite": "^6.0.3",
    "zustand": "^5.0.2"
  }
}
