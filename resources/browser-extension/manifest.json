{
  "manifest_version": 3,
  "name": "EastGenesis Browser Bridge",
  "version": "0.1.0",
  "description": "用户明确配对和授权一个标签后，让 EastGenesis 当前任务读取、截图和操作该标签。",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "debugger"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "EastGenesis 标签授权",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  },
  "key": ""
}
